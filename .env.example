# =============================================================================
# polyglot-commerce — environment configuration
#
# Optional. docker-compose.yml works out of the box with no .env file at
# all — every variable below has a working default for local use. Copy this
# file only if you're deploying somewhere other than your own machine:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend API URLs
#
# Create React App inlines REACT_APP_* variables into the JS bundle at BUILD
# time, so these must be a host the visitor's BROWSER can reach — your
# server's public IP/domain, not "localhost" and not an internal Docker
# service name. If you change these you must rebuild the client image:
#   docker compose up -d --build client
# -----------------------------------------------------------------------------
REACT_APP_ADMIN_API_URL=http://localhost:8000
REACT_APP_MAIN_API_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Host ports (optional overrides — defaults shown)
# -----------------------------------------------------------------------------
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
